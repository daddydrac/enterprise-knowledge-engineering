# Dataset view: asserted
# Expected rows or triples: 3
PREFIX ex: <https://example.org/health/ontology/> PREFIX skos: <http://www.w3.org/2004/02/skos/core#> PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?code ?n WHERE { { SELECT ?code (COUNT(?r) AS ?n) WHERE { ?r ex:primaryCode ?code } GROUP BY ?code } FILTER(?n = 20) }
