    <https://example.org/health/icd10cm/2026-04/E11.9> a skos:Concept ;
        skos:broader <https://example.org/health/icd10cm/2026-04/E11> ;
        skos:inScheme <https://example.org/health/icd10cm/2026-04/scheme> ;
        skos:notation "E11.9" ;
        skos:prefLabel "Type 2 diabetes mellitus without complications"@en .

    <https://example.org/health/icd10cm/2026-04/I50.9> a skos:Concept ;
        skos:broader <https://example.org/health/icd10cm/2026-04/I50> ;
        skos:inScheme <https://example.org/health/icd10cm/2026-04/scheme> ;
        skos:notation "I50.9" ;
        skos:prefLabel "Heart failure, unspecified"@en .

    <https://example.org/health/icd10cm/2026-04/J45.909> a skos:Concept ;
        skos:broader <https://example.org/health/icd10cm/2026-04/J45> ;
        skos:inScheme <https://example.org/health/icd10cm/2026-04/scheme> ;
        skos:notation "J45.909" ;
        skos:prefLabel "Unspecified asthma, uncomplicated"@en .

    <https://example.org/health/reporting/proposal493> a rdf:Statement ;
        rdf:object <https://example.org/health/icd10cm/2026-04/J45> ;
        rdf:predicate skos:closeMatch ;
        rdf:subject <https://example.org/health/icd9-source/493> ;
        prov:wasDerivedFrom <https://www.cdc.gov/nchs/icd/icd-10-cm/files.html> ;
        ns1:rationale "Similar category labels are not sufficient to certify coding equivalence. Compare release scopes, inclusions and exclusions." ;
        ns1:reviewRole "Terminology steward" ;
        ns1:status "proposed" .

    <https://example.org/health/reporting/source493> a skos:Concept ;
        skos:exactMatch <https://example.org/health/icd9-source/493> ;
        skos:inScheme <https://example.org/health/reporting/scheme> ;
        skos:prefLabel "Reporting alias for source code 493"@en ;
        skos:scopeNote "An exact alias of the source token concept in this release; not an equivalence across clinical code systems."@en .

    <https://example.org/health/icd10cm/2026-04/E11> a skos:Concept ;
        skos:inScheme <https://example.org/health/icd10cm/2026-04/scheme> ;
